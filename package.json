{
  "name": "@lariocpt/flawless-react",
  "version": "0.3.0",
  "description": "Multi-task quality kit for React components: scaffolds Playwright perf harness + Vitest unit + browser tests, runs static perf analysis, an accessibility scan, and Biome-driven React correctness rules. Point it at a .tsx file or glob and pick what to run.",
  "type": "module",
  "author": "Lario Borges",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lariocpt/flawless-react.git"
  },
  "bugs": {
    "url": "https://github.com/lariocpt/flawless-react/issues"
  },
  "homepage": "https://lariocpt.github.io/flawless-react-website/",
  "keywords": [
    "react",
    "testing",
    "playwright",
    "vitest",
    "accessibility",
    "performance",
    "biome",
    "code-generation"
  ],
  "license": "MIT",
  "bin": {
    "flawless-react": "./bin/flawless-react"
  },
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    ".agents/skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "dev": "bun src/cli.ts",
    "build": "bun build --compile --minify --outfile bin/flawless-react-bin src/bin.ts",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@biomejs/biome": "2.5.1",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.in.drlario.org",
    "access": "public"
  }
}
