{
  "name": "flawless-react",
  "version": "0.3.0-dev",
  "description": "Multi-task quality kit for React components: scaffolds Playwright perf harness + Vitest unit + browser tests, runs static perf analysis, an accessibility scan, and Biome-driven React correctness rules. Point it at a .tsx file or glob and pick what to run.",
  "type": "module",
  "author": "Lario Borges",
  "license": "MIT",
  "bin": {
    "flawless-react": "./bin/flawless-react"
  },
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "dev": "bun src/cli.ts",
    "build": "bun build --compile --minify --outfile bin/flawless-react-bin src/bin.ts",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@biomejs/biome": "^2.3.13",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.in.drlario.org"
  }
}
