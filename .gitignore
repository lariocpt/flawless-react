node_modules
dist
*.log
.DS_Store
.bun

# The compiled binary from `bun run build` — ~94 MB, produced and published by CI.
# Committing it is what happened in the crust repo: two 91 MB ELFs are in that history and
# its .git is 36 MB, growing with every rebuild.
# bin/flawless-react (the four-line bun shim) IS tracked; only the artifact is not.
bin/flawless-react-bin

# Test artefacts
.tmp
.fhr-verify
tests/.tmp
playwright-report
test-results
heaps

# Ephemeral agent worktrees — full checkouts of this repo, created and removed
# under it. Untracked and unignored, a `git add -A` from any session sweeps a
# copy of the tree into a commit.
.claude/worktrees/

# Sidecar summaries dropped beside fixtures by tests that run the analyser
tests/fixtures/*.flawless.json

# Generated by a fixture run of the tool against tests/fixtures/expoapp. The
# fixture SOURCE is committed; what a run emits into it is not — it is rebuilt by
# whichever test asked for it, and committing it would make the fixture's own
# regeneration show up as a diff.
tests/fixtures/expoapp/flawless/

# Written INTO the fixture by tests that run the tool against it. When --out
# points outside the project (as tests/expoRefusals.test.ts does, into a tmpdir),
# updateGitignore computes entries relative to the project and they come out as
# ../../../../tmp/... — meaningless to git and pure noise. The file is an
# artefact of running the tool, never fixture source.
tests/fixtures/expoapp/.gitignore
